# NPK firmware header, used by Mikrotik
0           belong        0x1EF1D0BA   NPK firmware header,
!:mime firmware/mikrotik-npk
>4          lelong        <0           {invalid}
>4          lelong        x            image size: %d,
>14         string        x            image name: "%s",
>(48.l+58)  string        x            description: "%s"
