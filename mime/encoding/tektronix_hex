# Tektronik HEX file format
0   string /
>1  regex  \^[0-9A-F]{12,}  Tektronix HEX; binary data in text format
!:mime  firmware/tek

# Tektronik Extended HEX file format
0    string %
>4   string 6
>1   regex  \^[0-9A-F]{12,}  Tektronix extended HEX; binary data in text format
!:mime  firmware/xtek
